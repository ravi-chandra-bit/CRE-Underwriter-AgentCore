# Copy to .env and `set -a; source .env; set +a` before running live/remote commands.
AWS_REGION=us-east-1
# Exact Bedrock model / cross-region inference profile id from the Bedrock console:
BEDROCK_MODEL_ID=anthropic.claude-opus-5-5
# Optional for local live runs (deployed runtime gets these from CDK):
GUARDRAIL_ID=
GUARDRAIL_VERSION=
# Remote invocation (or read from infra/outputs.json after `make deploy`):
UW_USERNAME=underwriter.cre-west@example.com
UW_PASSWORD=
